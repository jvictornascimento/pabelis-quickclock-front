# Vite development proxy only (not the Compose runtime).
API_PROXY_TARGET=http://127.0.0.1:8080

# Set a local password before starting Compose. Do not commit .env.
DATABASE_PASSWORD=replace-with-a-local-password
QUICKCLOCK_BIND_IP=127.0.0.1
QUICKCLOCK_PORT=8088
# Relative to the frontend repository; works with the current sibling folders.
QUICKCLOCK_BACKEND_PATH=../../Spring/QuickClock
